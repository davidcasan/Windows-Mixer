<UserControl x:Class="WinMixer.Views.SettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="#FF181A1E" Margin="10" CornerRadius="8" BorderBrush="Black" BorderThickness="1.5">
        <Border.Effect><DropShadowEffect ShadowDepth="4" BlurRadius="14" Opacity="0.8"/></Border.Effect>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid Margin="26,22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- left column -->
                <StackPanel>
                    <TextBlock Style="{StaticResource Engraved}" FontSize="16" Text="GENERAL" Foreground="{StaticResource Amber}"/>
                    <CheckBox x:Name="StartMin" Style="{StaticResource LedCheck}" Content="Start minimized" Margin="0,12,0,5" Click="General_Click"/>
                    <CheckBox x:Name="MinTray" Style="{StaticResource LedCheck}" Content="Minimize to system tray" Click="General_Click"/>
                    <CheckBox x:Name="CloseTray" Style="{StaticResource LedCheck}" Content="Close button hides to tray" Click="General_Click"/>
                    <CheckBox x:Name="Startup" Style="{StaticResource LedCheck}" Content="Start with Windows" Click="General_Click"/>

                    <TextBlock Style="{StaticResource Engraved}" FontSize="16" Text="VOLUME CURVE" Foreground="{StaticResource Amber}" Margin="0,26,0,0"/>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <RadioButton x:Name="CurveLog" GroupName="curve" Style="{StaticResource PosRadio}" Width="30" Click="Curve_Click"/>
                        <TextBlock Style="{StaticResource Engraved}" FontSize="13" VerticalAlignment="Center" Text="Logarithmic (dB)" Margin="6,0,24,0"/>
                        <RadioButton x:Name="CurveLin" GroupName="curve" Style="{StaticResource PosRadio}" Width="30" Click="Curve_Click"/>
                        <TextBlock Style="{StaticResource Engraved}" FontSize="13" VerticalAlignment="Center" Text="Linear" Margin="6,0,0,0"/>
                    </StackPanel>
                    <Grid Margin="0,14,0,0">
                        <TextBlock Style="{StaticResource Engraved}" FontSize="13" Text="Log range (knob bottom)"/>
                        <TextBlock x:Name="FloorText" Style="{StaticResource LcdLabel}" HorizontalAlignment="Right" Text="-60 dB"/>
                    </Grid>
                    <Slider x:Name="FloorSlider" Style="{StaticResource MetalSlider}" Minimum="-90" Maximum="-30" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="Floor_Changed" Margin="0,4,0,0"/>

                    <TextBlock Style="{StaticResource Engraved}" FontSize="16" Text="PRESETS &amp; DATA" Foreground="{StaticResource Amber}" Margin="0,26,0,0"/>
                    <TextBlock Style="{StaticResource Engraved}" FontSize="12" Foreground="{StaticResource DimBrush}" Text="Settings and presets are stored in:" Margin="0,12,0,4"/>
                    <TextBlock x:Name="DataPath" Style="{StaticResource LcdLabel}" FontSize="11" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Style="{StaticResource Btn}" Content="OPEN FOLDER" Padding="12,5" Click="OpenData_Click"/>
                        <Button Style="{StaticResource Btn}" Content="EXPORT PRESET…" Padding="12,5" Margin="6,0,0,0" Click="Export_Click"/>
                    </StackPanel>
                </StackPanel>

                <!-- right column: OSD -->
                <StackPanel Grid.Column="2">
                    <TextBlock Style="{StaticResource Engraved}" FontSize="16" Text="ON-SCREEN DISPLAY" Foreground="{StaticResource Amber}"/>
                    <CheckBox x:Name="OsdOn" Style="{StaticResource LedCheck}" Content="Show OSD when a control moves" Margin="0,12,0,5" Click="Osd_Click"/>

                    <TextBlock Style="{StaticResource Engraved}" FontSize="13" Text="Screen" Margin="0,10,0,4"/>
                    <ComboBox x:Name="MonitorBox" Style="{StaticResource LcdCombo}" Height="28" DisplayMemberPath="Label" SelectedValuePath="Key" SelectionChanged="Monitor_Changed"/>

                    <TextBlock Style="{StaticResource Engraved}" FontSize="13" Text="Position" Margin="0,14,0,4"/>
                    <UniformGrid x:Name="PosGrid" Columns="3" Width="130" HorizontalAlignment="Left"/>

                    <Grid Margin="0,14,0,0">
                        <TextBlock Style="{StaticResource Engraved}" FontSize="13" Text="Duration"/>
                        <TextBlock x:Name="DurText" Style="{StaticResource LcdLabel}" HorizontalAlignment="Right" Text="1.5 s"/>
                    </Grid>
                    <Slider x:Name="DurSlider" Style="{StaticResource MetalSlider}" Minimum="500" Maximum="5000" TickFrequency="250" IsSnapToTickEnabled="True" ValueChanged="Dur_Changed" Margin="0,4,0,0"/>

                    <Button Style="{StaticResource Btn}" Content="TEST OSD" HorizontalAlignment="Left" Margin="0,16,0,0" Padding="16,5" Click="Test_Click"/>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Border>
</UserControl>
