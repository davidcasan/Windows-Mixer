<Window x:Class="WinMixer.Views.OsdWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:WinMixer.Controls"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False"
        Topmost="True" ShowActivated="False" Focusable="False" ResizeMode="NoResize" SizeToContent="WidthAndHeight"
        Opacity="0">
    <Border Margin="14" Width="320" CornerRadius="10" Background="{x:Static ctl:Tex.Dark}" BorderBrush="#AA000000" BorderThickness="1.5" Padding="16,12">
        <Border.Effect><DropShadowEffect ShadowDepth="4" BlurRadius="16" Opacity="0.8"/></Border.Effect>
        <StackPanel>
            <Grid>
                <TextBlock x:Name="TitleText" Style="{StaticResource Engraved}" FontSize="16" FontWeight="SemiBold" Text="MASTER" TextTrimming="CharacterEllipsis" MaxWidth="190" HorizontalAlignment="Left"/>
                <TextBlock x:Name="ValueText" Style="{StaticResource LcdLabel}" FontSize="15" HorizontalAlignment="Right" Text="-6.0 dB"/>
            </Grid>
            <Border x:Name="BarWell" Margin="0,10,0,0" Height="12" CornerRadius="6" Background="#08090A" BorderBrush="#55FFFFFF" BorderThickness="1">
                <Grid>
                    <Border x:Name="Fill" HorizontalAlignment="Left" Width="0" CornerRadius="5" Margin="1">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#3CE05A" Offset="0"/>
                                <GradientStop Color="#FFC41F" Offset="0.75"/>
                                <GradientStop Color="#FF2D1F" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.Effect><DropShadowEffect Color="#FF9F1C" ShadowDepth="0" BlurRadius="8" Opacity="0.5"/></Border.Effect>
                    </Border>
                </Grid>
            </Border>
        </StackPanel>
    </Border>
</Window>
