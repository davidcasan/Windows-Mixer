<UserControl x:Class="WinMixer.Views.StripView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:WinMixer.Controls"
             Width="176" Margin="6,6,0,6">
    <UserControl.Resources>
        <Style x:Key="Tiny" TargetType="TextBlock" BasedOn="{StaticResource Engraved}">
            <Setter Property="FontSize" Value="9.5"/>
            <Setter Property="Foreground" Value="{StaticResource DimBrush}"/>
        </Style>
        <Style x:Key="XBtn" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
        </Style>
    </UserControl.Resources>

    <Border CornerRadius="8" BorderBrush="#0A0B0C" BorderThickness="1.5" Background="{x:Static ctl:Tex.Plate}">
        <Border.Effect><DropShadowEffect ShadowDepth="4" BlurRadius="12" Opacity="0.75"/></Border.Effect>
        <Grid>
            <!-- lighting overlay -->
            <Border CornerRadius="7">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#40FFFFFF" Offset="0"/>
                        <GradientStop Color="#00FFFFFF" Offset="0.18"/>
                        <GradientStop Color="#00000000" Offset="0.7"/>
                        <GradientStop Color="#55000000" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <Border CornerRadius="7" BorderBrush="#55FFFFFF" BorderThickness="1,1,0,0" Margin="1"/>

            <ctl:ScrewControl Tag="20" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6,6,0,0"/>
            <ctl:ScrewControl Tag="75" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,6,0"/>
            <ctl:ScrewControl Tag="140" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="6,0,0,6"/>
            <ctl:ScrewControl Tag="100" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,6,6"/>

            <Grid Margin="12,22,12,22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- target selector -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Ellipse x:Name="Link" Width="8" Height="8" Margin="0,0,6,0" Fill="#3A1410" Stroke="Black"/>
                    <ComboBox x:Name="TargetBox" Grid.Column="1" Style="{StaticResource LcdCombo}" Height="26"
                              DisplayMemberPath="Label" SelectedValuePath="Key"
                              SelectedValue="{Binding Target, Mode=TwoWay}"/>
                    <Button Grid.Column="2" Style="{StaticResource XBtn}" Content="✕" Margin="6,0,0,0" ToolTip="Remove strip" Click="Remove_Click"/>
                </Grid>

                <!-- knob + meter -->
                <Grid Grid.Row="1" Margin="0,8,0,0" Height="118">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ctl:KnobControl x:Name="Knob" Value="{Binding Position, Mode=TwoWay}" Dimmed="{Binding Muted}" ToolTip="Drag / wheel (Shift = fine) · double-click = 0 dB"/>
                    <ctl:MeterControl Grid.Column="1" Width="30" Margin="6,0,0,0" LevelL="{Binding LevelL}" LevelR="{Binding LevelR}"/>
                </Grid>

                <!-- LCD readout -->
                <Border Grid.Row="2" Margin="0,8,0,0" CornerRadius="3" Background="{StaticResource LcdBack}" BorderBrush="#66FFFFFF" BorderThickness="1" Padding="6,4">
                    <StackPanel>
                        <Grid>
                            <TextBlock Style="{StaticResource LcdLabel}" FontSize="17" Text="{Binding ReadoutDb}"/>
                            <TextBlock Style="{StaticResource LcdLabel}" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Bottom" Text="{Binding ReadoutPct}" Opacity="0.8"/>
                        </Grid>
                        <TextBlock Style="{StaticResource LcdLabel}" FontSize="10" Opacity="0.65" Text="{Binding SubLabel}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>

                <ToggleButton Grid.Row="3" Margin="0,8,0,0" Style="{StaticResource LedToggle}" Content="MUTE" IsChecked="{Binding Muted, Mode=TwoWay}"/>

                <!-- volume binding -->
                <StackPanel Grid.Row="4" Margin="0,10,0,0">
                    <TextBlock Style="{StaticResource Tiny}" Text="VOLUME CONTROL"/>
                    <Grid Margin="0,3,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="LearnVol" Style="{StaticResource Btn}" Content="LEARN" Padding="0,3" Click="LearnVol_Click"/>
                        <ToggleButton Grid.Column="1" Style="{StaticResource LedToggle}" Tag="#FF9F1C" Content="REL" Margin="4,0,0,0" FontSize="10" IsChecked="{Binding Relative, Mode=TwoWay}" ToolTip="Relative (endless encoder) mode"/>
                        <Button Grid.Column="2" Style="{StaticResource XBtn}" Content="✕" Margin="4,0,0,0" ToolTip="Clear" Click="ClearVol_Click"/>
                    </Grid>
                    <TextBlock Style="{StaticResource LcdLabel}" FontSize="10" Margin="0,3,0,0" Text="{Binding VolumeBindingText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding VolumeBindingText}"/>
                </StackPanel>

                <!-- mute binding -->
                <StackPanel Grid.Row="5" Margin="0,8,0,0">
                    <TextBlock Style="{StaticResource Tiny}" Text="MUTE BUTTON"/>
                    <Grid Margin="0,3,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="LearnMute" Style="{StaticResource Btn}" Content="LEARN" Padding="0,3" Click="LearnMute_Click"/>
                        <Button Grid.Column="1" Style="{StaticResource XBtn}" Content="✕" Margin="4,0,0,0" ToolTip="Clear" Click="ClearMute_Click"/>
                    </Grid>
                    <TextBlock Style="{StaticResource LcdLabel}" FontSize="10" Margin="0,3,0,0" Text="{Binding MuteBindingText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding MuteBindingText}"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
