<Application x:Class="WinMixer.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <Color x:Key="AmberColor">#FF9F1C</Color>
        <SolidColorBrush x:Key="Amber" Color="{StaticResource AmberColor}"/>
        <SolidColorBrush x:Key="TextBrush" Color="#D8DBDF"/>
        <SolidColorBrush x:Key="DimBrush" Color="#8C9298"/>
        <SolidColorBrush x:Key="LcdBack" Color="#0F0D08"/>
        <SolidColorBrush x:Key="LcdText" Color="#FFB347"/>
        <FontFamily x:Key="UiFont">Bahnschrift SemiCondensed, Segoe UI</FontFamily>
        <FontFamily x:Key="LcdFont">Consolas</FontFamily>

        <LinearGradientBrush x:Key="BevelUp" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#5B6068" Offset="0"/>
            <GradientStop Color="#3A3E44" Offset="0.5"/>
            <GradientStop Color="#2A2D32" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="BevelHover" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#6A7078" Offset="0"/>
            <GradientStop Color="#454A51" Offset="0.5"/>
            <GradientStop Color="#33373D" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="BevelDown" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#1E2024" Offset="0"/>
            <GradientStop Color="#2B2E33" Offset="1"/>
        </LinearGradientBrush>

        <!-- engraved text -->
        <Style x:Key="Engraved" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="Black" Direction="90" ShadowDepth="1" BlurRadius="0" Opacity="0.85"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LcdLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource LcdFont}"/>
            <Setter Property="Foreground" Value="{StaticResource LcdText}"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#FF9F1C" ShadowDepth="0" BlurRadius="6" Opacity="0.55"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- button with centered content (ContentPresenter inside) -->
        <Style x:Key="Btn" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="4" Background="{StaticResource BevelUp}" BorderBrush="#101113" BorderThickness="1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Border.Effect><DropShadowEffect ShadowDepth="1" BlurRadius="2" Opacity="0.6"/></Border.Effect>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="{StaticResource BevelHover}"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Background" Value="{StaticResource BevelDown}"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- toggle with LED. LedColor via Tag -->
        <Style x:Key="LedToggle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Tag" Value="#FF3B2F"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bd" CornerRadius="4" Background="{StaticResource BevelUp}" BorderBrush="#101113" BorderThickness="1" Padding="8,4">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Ellipse x:Name="led" Width="9" Height="9" Fill="#2A0F0D" Stroke="#000" StrokeThickness="1" Margin="0,0,7,0"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                            <Border.Effect><DropShadowEffect ShadowDepth="1" BlurRadius="2" Opacity="0.6"/></Border.Effect>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="{StaticResource BevelHover}"/></Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource BevelDown}"/>
                                <Setter TargetName="led" Property="Fill" Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"/>
                                <Setter TargetName="led" Property="Effect">
                                    <Setter.Value><DropShadowEffect Color="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" ShadowDepth="0" BlurRadius="10" Opacity="0.95"/></Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- LED checkbox -->
        <Style x:Key="LedCheck" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Margin" Value="0,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border Width="30" Height="16" CornerRadius="8" Background="#0B0C0D" BorderBrush="#55FFFFFF" BorderThickness="1" Margin="0,0,10,0">
                                <Ellipse x:Name="knob" Width="10" Height="10" Fill="#5A5E64" HorizontalAlignment="Left" Margin="3,0,0,0"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="knob" Property="Fill" Value="{StaticResource Amber}"/>
                                <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="knob" Property="Margin" Value="0,0,3,0"/>
                                <Setter TargetName="knob" Property="Effect">
                                    <Setter.Value><DropShadowEffect Color="#FF9F1C" ShadowDepth="0" BlurRadius="9" Opacity="0.9"/></Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- small radio-like square toggle (OSD position grid) -->
        <Style x:Key="PosRadio" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" CornerRadius="3" Background="{StaticResource BevelUp}" BorderBrush="#101113" BorderThickness="1">
                            <Ellipse x:Name="dot" Width="8" Height="8" Fill="#14151A"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="{StaticResource BevelHover}"/></Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="dot" Property="Fill" Value="{StaticResource Amber}"/>
                                <Setter TargetName="dot" Property="Effect">
                                    <Setter.Value><DropShadowEffect Color="#FF9F1C" ShadowDepth="0" BlurRadius="9" Opacity="0.9"/></Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- LCD combo box -->
        <Style x:Key="LcdItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource LcdText}"/>
            <Setter Property="FontFamily" Value="{StaticResource LcdFont}"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="bd" Property="Background" Value="#3A2B10"/></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="bd" Property="Background" Value="#4A3513"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LcdCombo" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource LcdText}"/>
            <Setter Property="FontFamily" Value="{StaticResource LcdFont}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource LcdItem}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="tb" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border CornerRadius="3" Background="{StaticResource LcdBack}" BorderBrush="#66000000" BorderThickness="1">
                                            <Border BorderBrush="#33FFFFFF" BorderThickness="0,0,0,1" CornerRadius="3">
                                                <Path Data="M0,0 L8,0 L4,5 Z" Fill="{StaticResource LcdText}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                            </Border>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter IsHitTestVisible="False" Margin="8,3,22,3" VerticalAlignment="Center"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              TextElement.Foreground="{StaticResource LcdText}"/>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                <Border MinWidth="{TemplateBinding ActualWidth}" MaxHeight="260" Background="#0F0D08" BorderBrush="#88FF9F1C" BorderThickness="1" CornerRadius="3" Margin="0,2,0,6">
                                    <Border.Effect><DropShadowEffect ShadowDepth="3" BlurRadius="8" Opacity="0.7"/></Border.Effect>
                                    <ScrollViewer>
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LcdBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource LcdText}"/>
            <Setter Property="FontFamily" Value="{StaticResource LcdFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CaretBrush" Value="{StaticResource LcdText}"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border CornerRadius="3" Background="{StaticResource LcdBack}" BorderBrush="#66FFFFFF" BorderThickness="1">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- slider -->
        <Style x:Key="MetalSlider" TargetType="Slider">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Border Height="6" CornerRadius="3" Background="#0B0C0D" BorderBrush="#55FFFFFF" BorderThickness="1" VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                        <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                        <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="16" Height="22" Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border CornerRadius="3" Background="{StaticResource BevelHover}" BorderBrush="#101113" BorderThickness="1">
                                                    <Rectangle Width="2" Fill="{StaticResource Amber}" Margin="0,3"/>
                                                    <Border.Effect><DropShadowEffect ShadowDepth="2" BlurRadius="3" Opacity="0.7"/></Border.Effect>
                                                </Border>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- scrollbars -->
        <Style TargetType="ScrollBar">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid x:Name="root" Background="#33000000">
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageLeftCommand" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageRightCommand" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border CornerRadius="4" Background="{StaticResource BevelHover}" BorderBrush="#101113" BorderThickness="1" Margin="1"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal"><Setter Property="Height" Value="12"/></Trigger>
                <Trigger Property="Orientation" Value="Vertical"><Setter Property="Width" Value="12"/></Trigger>
            </Style.Triggers>
        </Style>
    </Application.Resources>
</Application>
